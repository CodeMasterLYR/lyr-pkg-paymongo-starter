APP_NAME="LYR PayMongo Starter"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Database — SQLite for quick local dev
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=lyr_paymongo
# DB_USERNAME=root
# DB_PASSWORD=

# PayMongo API Keys (get from dashboard.paymongo.com > Developers)
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key_here
PAYMONGO_SECRET_KEY=sk_test_your_secret_key_here
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_secret_here

# Where PayMongo should redirect after payment
PAYMONGO_SUCCESS_URL=http://localhost:3000/success
PAYMONGO_CANCEL_URL=http://localhost:3000/cancel

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost

# Mobile App Identification (send as X-App-Key header from mobile clients)
MOBILE_APP_KEY=your-secure-random-key-here
