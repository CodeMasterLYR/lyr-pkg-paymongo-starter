# Normalize line endings for all text files
* text=auto

# Force LF for these file types (important for PHP, JS, TS, CSS, MD)
*.php      text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.mjs      text eol=lf
*.json     text eol=lf
*.css      text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.env*     text eol=lf
*.gitignore text eol=lf
artisan    text eol=lf

# Binary files — no line ending conversion
*.png      binary
*.jpg      binary
*.jpeg     binary
*.ico      binary
*.svg      binary
